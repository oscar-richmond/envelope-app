datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id              Int       @id @default(autoincrement())
  companyName     String
  websiteUrl      String    @unique
  industry        String?
  location        String?
  
  // Scoring
  stalenessScore  Int       @default(0)
  scoreConfidence String    @default("LOW")
  scoreReasons    String?   // JSON
  lastAnalyzedAt  DateTime?
  
  // Analysis Signals
  copyrightYear   Int?
  hasSitemap      Boolean   @default(false)
  sitemapLastMod  DateTime? // NEW
  blogLastPost    DateTime? // NEW
  metaViewport    Boolean   @default(false)
  generatorTag    String?
  
  // Outreach
  emailDraft      String?   // Latest draft body (Text fallback)
  emailDraftHtml  String?   // Latest draft body (HTML)
  subjectLine1    String?
  subjectLine2    String?
  emailStatus     String    @default("NEW") // NEW, ANALYSED, DRAFTED, APPROVED, SENT
  approvedAt      DateTime?
  lastDraftSavedAt DateTime?

  // Relations
  companyProspectId Int?
  companyProspect   CompanyProspect? @relation(fields: [companyProspectId], references: [id])

  drafts          EmailDraft[]
  contacts        Contact[]
  outreachMessages OutreachMessage[]
  sentEmails      SentEmail[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model CompanyProspect {
  id                      Int       @id @default(autoincrement())
  companyName             String
  companyNumber           String    @unique // Companies House ID
  industry                String?
  sicCodes                String?   // CSV
  employeeSizeBand        String?
  registeredLocation      String?
  websiteUrl              String?
  websiteConfidence       String    @default("LOW") // LOW, MEDIUM, HIGH
  websiteBrandName        String?   // Extracted brand name (e.g. "Google" vs "Google LLC")
  websiteBrandNameSource  String?   // og_site_name, title, h1, logo_alt, domain_fallback, manual
  websiteBrandNameConfidence String? // HIGH, MEDIUM, LOW
  brandNameOverride       String?   // Manual override
  brandNameOverrideUpdatedAt DateTime?
  websiteDomain           String?   // Normalized domain
  source                  String    @default("companies_house")
  status                  String    @default("NEW") // NEW, ADDED, REJECTED
  searchCriteria          String?   // JSON string of criteria used to find this prospect
  
  // Website Discovery
  websiteDiscoveryMethod  String?   // e.g. "google_places"
  websiteMatchEvidence    String?   // JSON
  websiteLastMatchedAt    DateTime?
  websiteMatchStatus      String?   // NEW, MATCHED, NEEDS_REVIEW, NOT_FOUND, FAILED
  websiteMatchFailureReason String?
  
  // Staleness Analysis
  stalenessScore          Int?      @default(0)
  stalenessConfidence     String?   // HIGH, MEDIUM, LOW
  scoreReasons            String?   // JSON
  signals                 String?   // JSON
  lastAnalysedAt          DateTime?

  // Financial Analysis (Companies House)
  financialActivityScore  Int?      @default(0) // 0-100
  financialActivityBand   String?   // "Very Strong", "Strong", "Medium", "Low"
  financialSignals        String?   // JSON
  financialLastCheckedAt  DateTime?

  // Contact Priority (Derived)
  contactPriorityScore    Int?      @default(0)
  contactPriorityBand     String?   // "High", "Medium", "Low"
  contactPriorityLastCalculatedAt DateTime?

  // Google Places Data
  placeId                   String?
  placesDisplayName         String?
  placesCategory            String?
  placesSecondaryCategories String?   // JSON array
  placesFormattedAddress    String?
  placesPhoneE164           String?
  placesMapsUrl             String?
  placesLat                 Float?
  placesLng                 Float?
  placesBusinessStatus      String?   // OPERATIONAL, CLOSED_TEMPORARILY, etc.
  placesOpeningHours        String?   // JSON
  placesPriceLevel          Int?
  placesRating              Float?
  placesReviewCount         Int?
  placesDetailsRawJson      String?
  placesDetailsFetchedAt    DateTime?

  // Website Metadata (cached)
  websiteMetaTitle          String?
  websiteMetaDescription    String?
  websiteMetaRawJson        String?
  websiteMetaFetchedAt      DateTime?

  // AI-Generated Content
  aiOneLiner                String?
  aiOverview                String?
  aiReputationSummary       String?
  aiGeneratedAt             DateTime?
  aiInputsSnapshot          String?   // JSON
  aiModelVersion            String?

  // Display Name Resolution
  displayBrandName          String?
  displayBrandNameSource    String?   // brandOverride, websiteBrand, places, domain, legal

  // Relations
  leads                   Lead[]
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  discoveredEmails        ProspectEmail[]
}

model ProspectEmail {
  id              Int      @id @default(autoincrement())
  companyProspectId Int
  companyProspect CompanyProspect @relation(fields: [companyProspectId], references: [id])
  
  email           String
  type            String   @default("GENERAL") // GENERAL, SALES, SUPPORT, PERSONAL
  confidence      String   @default("MEDIUM")  // HIGH, MEDIUM, LOW
  sourceUrl       String?
  contextSnippet  String?
  name            String?  // Scraped name
  roleTitle       String?  // Scraped or inferred role
  roleConfidence  String?  // HIGH, MEDIUM, LOW
  roleSource      String?  // contact_match, page_context, role_email_prefix, manual, unknown
  
  createdAt       DateTime @default(now())

  // Verification Signals
  syntaxValid     Boolean?
  mxValid         Boolean?
  roleRisk        String?  // HIGH, MEDIUM, LOW, NONE
  sendabilityStatus String? // GOOD, CAUTION, HIGH_RISK
  checkedAt       DateTime?
}

model EmailDraft {
  id           Int      @id @default(autoincrement())
  leadId       Int
  lead         Lead     @relation(fields: [leadId], references: [id])
  version      Int
  subjectLine1 String
  subjectLine2 String
  body         String
  bodyHtml     String?
  createdAt    DateTime @default(now())
}

model Contact {
  id              Int      @id @default(autoincrement())
  leadId          Int
  lead            Lead     @relation(fields: [leadId], references: [id])
  firstName       String?
  lastName        String?
  title           String?
  email           String?
  confidence      Int      @default(0) // 0-100
  roleCategory    String?  // "DECISION_MAKER", "MARKETING", "OTHER"
  isPrimary       Boolean  @default(false)
  source          String?
  
  outreachMessages OutreachMessage[]
  
  createdAt       DateTime @default(now())
}

model OutreachMessage {
  id              Int      @id @default(autoincrement())
  leadId          Int
  lead            Lead     @relation(fields: [leadId], references: [id])
  contactId       Int?
  contact         Contact? @relation(fields: [contactId], references: [id])
  
  subject         String
  body            String
  bodyHtml        String?
  status          String   @default("DRAFT") // DRAFT, QUEUED, SENT, FAILED, BOUNCED
  
  gmailDraftId    String?
  gmailMessageId  String?
  gmailThreadId   String?
  sentAt          DateTime?
  errorLog        String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SentEmail {
  id              Int       @id @default(autoincrement())
  leadId          Int
  lead            Lead      @relation(fields: [leadId], references: [id])
  
  // Gmail Threading
  formattedTo     String    // "Oscar <oscar@example.com>"
  sentMessageId   String?   // Gmail Message ID
  sentThreadId    String?   // Gmail Thread ID
  
  // Content Snapshot
  subject         String
  bodyText        String    @db.Text
  bodyHtml        String?   @db.Text
  
  // Workflow Status
  status          String    @default("SENT") // SENT, REPLIED, FOLLOW_UP_DUE, FOLLOWED_UP, CLOSED, BOUNCED
  sentAt          DateTime  @default(now())
  
  // Tracking
  replyDetectedAt DateTime?
  lastCheckedAt   DateTime?

  // Analysis
  replySentiment  String?   // Legacy: INTERESTED, NOT_INTERESTED, OOO, OTHER
  replyIntent     String?   // New: INTERESTED, NOT_NOW, NOT_INTERESTED, REFERRAL, AUTO_REPLY, UNCLEAR
  replySummary    String?   
  replyConfidence Int?      // 0-100
  
  // Conversation Outcome (CRM-lite)
  // Canonical outcomes: INTERESTED, NOT_NOW, NOT_INTERESTED, REFERRED, NO_RESPONSE, CLOSED
  conversationOutcome           String?   // Active outcome
  outcomeSetAt                  DateTime? // When outcome was set
  outcomeSetBy                  String?   // 'ai' or 'user'
  suggestedOutcome              String?   // AI-suggested outcome
  suggestedOutcomeConfidence    Int?      // 0-100 confidence
  manualOutcomeOverride         Boolean   @default(false) // User manually set/changed
  
  // Kanban Board (Post-Intent)
  // Columns: INTERESTED, CALL_PROPOSED, CALL_COMPLETED, PAUSED, CLOSED
  kanbanColumn      String?   // Current column on board
  lastActivityAt    DateTime? // For ordering within columns
  
  // Private Notes (Optional, Minimal)
  notesText         String?   // Private notes, max ~800 chars
  notesUpdatedAt    DateTime? // Last edit timestamp
  
  // Follow Up Logic
  followUpCount         Int       @default(0) // 0 = Initial, 1 = First FU sent, 2 = Second FU sent
  nextFollowUpAt        DateTime? // When the next follow-up is due
  lastFollowUpSentAt    DateTime?
  followUpSnoozedUntil  DateTime? // If snoozed, when to resurface
  followUpSkipped       Boolean   @default(false)
  followUpPriorityScore Int?      // 0-100 priority for queue ordering
  followUpReasonSummary String?   // e.g. "High opportunity, overdue 2 days"
  
  // Unibox Queue Tracking
  lastInboundAt         DateTime? // Timestamp of last inbound message in thread
  lastOutboundAt        DateTime? // Timestamp of last outbound message (us)
  deliveryError         String?   // Bounce/failure reason if any
  closedAt              DateTime? // When manually marked closed
  closedReason          String?   // Optional close reason
  
  // Relations
  followUpQueueItems    FollowUpQueueItem[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([status])
  @@index([nextFollowUpAt])
  @@index([followUpPriorityScore])
  @@index([lastInboundAt])
  @@index([lastOutboundAt])
}

model FollowUpQueueItem {
  id              Int       @id @default(autoincrement())
  sentEmailId     Int
  sentEmail       SentEmail @relation(fields: [sentEmailId], references: [id])
  
  // Context
  recipientEmail  String
  followUpNumber  Int       // 1 or 2
  
  // Scheduling
  dueAt           DateTime
  priorityScore   Int       @default(0) // 0-100
  
  // Status
  status          String    @default("QUEUED") // QUEUED, SNOOZED, SKIPPED, COMPLETED
  snoozedUntil    DateTime?
  
  // Draft Content
  draftSubject    String
  draftBodyText   String    @db.Text
  draftBodyHtml   String?   @db.Text
  draftVariant    String    @default("call-first") // call-first, email-ideas-first
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([status])
  @@index([dueAt])
  @@index([priorityScore])
}

model GmailAccount {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  accessToken     String   
  refreshToken    String   
  expiryDate      BigInt
  dailyLimit      Int      @default(20)
  sentToday       Int      @default(0)
  lastSentAt      DateTime?
  
  // Sender Protection
  totalSent30d          Int       @default(0)  // Rolling 30-day total
  totalBounces30d       Int       @default(0)  // Rolling 30-day bounces
  totalReplies30d       Int       @default(0)  // Rolling 30-day replies
  lastSpamComplaintAt   DateTime?              // Triggers COOLING_DOWN
  senderStatus          String    @default("WARMING") // WARMING, WARM, COOLING_DOWN
}

model SuppressionEntry {
  id              Int      @id @default(autoincrement())
  domain          String?  @unique
  email           String?  @unique
  reason          String?
  createdAt       DateTime @default(now())
}

model Settings {
  id                  Int     @id @default(1)
  openaiApiKey        String?
  toneGuidelines      String?
  emailSignature      String?
  dailySendLimit      Int     @default(50)
  
  // Follow-up Configuration
  followUpDelayDays   Int     @default(4)  // Business days for FU1
  followUp2DelayDays  Int     @default(7)  // Business days for FU2 (after FU1)
  followUp2Enabled    Boolean @default(false)
  maxFollowUpAgeDays  Int     @default(45) // Max age before no more follow-ups
  timezone            String  @default("Europe/London")
}

// --- Auth & Waitlist Models ---

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  
  // Custom Fields
  isAdmin       Boolean         @default(false)
  accessStatus  String          @default("waitlisted") // waitlisted, approved, denied
  accessRequestedAt DateTime    @default(now())
  approvedAt    DateTime?
  deniedAt      DateTime?
  approvedByUserId String?
  requestNote   String?
  company       String?
  lastLoginAt   DateTime?
  
  passkeys      PasskeyCredential[]
 
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}

model PasskeyCredential {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt
  transports   String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?
}
