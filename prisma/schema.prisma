datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id              Int       @id @default(autoincrement())
  companyName     String
  websiteUrl      String    @unique
  industry        String?
  location        String?
  
  // Scoring
  stalenessScore  Int       @default(0)
  scoreConfidence String    @default("LOW")
  scoreReasons    String?   // JSON
  lastAnalyzedAt  DateTime?
  
  // Analysis Signals
  copyrightYear   Int?
  hasSitemap      Boolean   @default(false)
  sitemapLastMod  DateTime? // NEW
  blogLastPost    DateTime? // NEW
  metaViewport    Boolean   @default(false)
  generatorTag    String?
  
  // Outreach
  emailDraft      String?   // Latest draft body (Text fallback)
  emailDraftHtml  String?   // Latest draft body (HTML)
  subjectLine1    String?
  subjectLine2    String?
  emailStatus     String    @default("NEW") // NEW, ANALYSED, DRAFTED, APPROVED, SENT
  approvedAt      DateTime?
  lastDraftSavedAt DateTime?

  // Relations
  companyProspectId Int?
  companyProspect   CompanyProspect? @relation(fields: [companyProspectId], references: [id])

  drafts          EmailDraft[]
  contacts        Contact[]
  outreachMessages OutreachMessage[]
  sentEmails      SentEmail[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model CompanyProspect {
  id                      Int       @id @default(autoincrement())
  companyName             String
  companyNumber           String    @unique // Companies House ID
  industry                String?
  sicCodes                String?   // CSV
  employeeSizeBand        String?
  registeredLocation      String?
  websiteUrl              String?
  websiteConfidence       String    @default("LOW") // LOW, MEDIUM, HIGH
  websiteBrandName        String?   // Extracted brand name (e.g. "Google" vs "Google LLC")
  websiteBrandNameSource  String?   // og_site_name, title, h1, logo_alt, domain_fallback, manual
  websiteBrandNameConfidence String? // HIGH, MEDIUM, LOW
  brandNameOverride       String?   // Manual override
  brandNameOverrideUpdatedAt DateTime?
  websiteDomain           String?   // Normalized domain
  source                  String    @default("companies_house")
  status                  String    @default("NEW") // NEW, ADDED, REJECTED
  searchCriteria          String?   // JSON string of criteria used to find this prospect
  
  // Website Discovery
  websiteDiscoveryMethod  String?   // e.g. "google_places"
  websiteMatchEvidence    String?   // JSON
  websiteLastMatchedAt    DateTime?
  websiteMatchStatus      String?   // NEW, MATCHED, NEEDS_REVIEW, NOT_FOUND, FAILED
  websiteMatchFailureReason String?
  
  // Staleness Analysis
  stalenessScore          Int?      @default(0)
  stalenessConfidence     String?   // HIGH, MEDIUM, LOW
  scoreReasons            String?   // JSON
  signals                 String?   // JSON
  lastAnalysedAt          DateTime?

  // Financial Analysis (Companies House)
  financialActivityScore  Int?      @default(0) // 0-100
  financialActivityBand   String?   // "Very Strong", "Strong", "Medium", "Low"
  financialSignals        String?   // JSON
  financialLastCheckedAt  DateTime?

  // Contact Priority (Derived)
  contactPriorityScore    Int?      @default(0)
  contactPriorityBand     String?   // "High", "Medium", "Low"
  contactPriorityLastCalculatedAt DateTime?

  // Relations
  leads                   Lead[]
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  discoveredEmails        ProspectEmail[]
}

model ProspectEmail {
  id              Int      @id @default(autoincrement())
  companyProspectId Int
  companyProspect CompanyProspect @relation(fields: [companyProspectId], references: [id])
  
  email           String
  type            String   @default("GENERAL") // GENERAL, SALES, SUPPORT, PERSONAL
  confidence      String   @default("MEDIUM")  // HIGH, MEDIUM, LOW
  sourceUrl       String?
  contextSnippet  String?
  name            String?  // Scraped name
  roleTitle       String?  // Scraped or inferred role
  roleConfidence  String?  // HIGH, MEDIUM, LOW
  roleSource      String?  // contact_match, page_context, role_email_prefix, manual, unknown
  
  createdAt       DateTime @default(now())

  // Verification Signals
  syntaxValid     Boolean?
  mxValid         Boolean?
  roleRisk        String?  // HIGH, MEDIUM, LOW, NONE
  sendabilityStatus String? // GOOD, CAUTION, HIGH_RISK
  checkedAt       DateTime?
}

model EmailDraft {
  id           Int      @id @default(autoincrement())
  leadId       Int
  lead         Lead     @relation(fields: [leadId], references: [id])
  version      Int
  subjectLine1 String
  subjectLine2 String
  body         String
  bodyHtml     String?
  createdAt    DateTime @default(now())
}

model Contact {
  id              Int      @id @default(autoincrement())
  leadId          Int
  lead            Lead     @relation(fields: [leadId], references: [id])
  firstName       String?
  lastName        String?
  title           String?
  email           String?
  confidence      Int      @default(0) // 0-100
  roleCategory    String?  // "DECISION_MAKER", "MARKETING", "OTHER"
  isPrimary       Boolean  @default(false)
  source          String?
  
  outreachMessages OutreachMessage[]
  
  createdAt       DateTime @default(now())
}

model OutreachMessage {
  id              Int      @id @default(autoincrement())
  leadId          Int
  lead            Lead     @relation(fields: [leadId], references: [id])
  contactId       Int?
  contact         Contact? @relation(fields: [contactId], references: [id])
  
  subject         String
  body            String
  bodyHtml        String?
  status          String   @default("DRAFT") // DRAFT, QUEUED, SENT, FAILED, BOUNCED
  
  gmailDraftId    String?
  gmailMessageId  String?
  gmailThreadId   String?
  sentAt          DateTime?
  errorLog        String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SentEmail {
  id              Int       @id @default(autoincrement())
  leadId          Int
  lead            Lead      @relation(fields: [leadId], references: [id])
  
  // Gmail Threading
  formattedTo     String    // "Oscar <oscar@example.com>"
  sentMessageId   String?   // Gmail Message ID
  sentThreadId    String?   // Gmail Thread ID
  
  // Content Snapshot
  subject         String
  bodyText        String    @db.Text
  bodyHtml        String?   @db.Text
  
  // Workflow Status
  status          String    @default("SENT") // SENT, REPLIED, FOLLOW_UP_DUE, FOLLOWED_UP, CLOSED, BOUNCED
  sentAt          DateTime  @default(now())
  
  // Tracking
  replyDetectedAt DateTime?
  lastCheckedAt   DateTime?
  
  // Follow Up Logic
  followUpCount   Int       @default(0) // 0 = Initial, 1 = First FU sent
  nextFollowUpAt  DateTime? // When the next check/action is due
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([status])
  @@index([nextFollowUpAt])
}

model GmailAccount {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  accessToken     String   
  refreshToken    String   
  expiryDate      BigInt
  dailyLimit      Int      @default(20)
  sentToday       Int      @default(0)
  lastSentAt      DateTime?
}

model SuppressionEntry {
  id              Int      @id @default(autoincrement())
  domain          String?  @unique
  email           String?  @unique
  reason          String?
  createdAt       DateTime @default(now())
}

model Settings {
  id              Int    @id @default(1)
  openaiApiKey    String?
  toneGuidelines  String?
  emailSignature  String?
  dailySendLimit  Int    @default(50)
  followUpDelayDays Int  @default(4)
}
